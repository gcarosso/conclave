      "max_turns": 10,
      "codex_sandbox": "read-only",
      "review": false
    },
    "file-back": {
      "description": "KB: file an output into the wiki",
      "default_vendor": "claude",
      "default_tier": 1,
      "max_turns": 5,
      "codex_sandbox": "workspace-write",
      "review": false
    },
    "lint": {
      "description": "KB: health check",
      "default_vendor": "claude",
      "default_tier": 1,
      "max_turns": 20,
      "codex_sandbox": "read-only",
      "review": false
    }
